{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cute-ronova",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "cuteronova.feminismindia.com",
      "custom_domain": true
    }
  ]
}
